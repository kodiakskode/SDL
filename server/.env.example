# Copy to .env and fill in. Never commit the real .env.

# AES-256-GCM key SMTP passwords are encrypted with at rest. 32 chars min.
OUTREACH_SECRET=change_me_to_32_characters_min!!

# Port for the server.
PORT=3021

# API prefix. Routes are served at <OUTREACH_API_BASE>/*
# Must match API_BASE in outreach.html.
OUTREACH_API_BASE=/rawleads/api

# Comma-separated list of origins allowed to call this API (CORS). Must be
# the dashboard's real GitHub Pages origin — no path, no trailing slash.
OUTREACH_ALLOWED_ORIGIN=https://kodiakskode.github.io

# SQLite file.
DB_PATH=./outreach.db

# There is no login on this API (see server/no-auth.js) — anyone who can
# reach OUTREACH_API_BASE can send mail through the SMTP account configured
# in the Outreach tab. Keep OUTREACH_ALLOWED_ORIGIN narrow, don't publish
# this server's URL, and put it behind auth at the network level (e.g. an
# nginx basic-auth or IP allowlist in front of it) if that's not enough.
