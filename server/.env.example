# Copy to .env and fill in. Never commit the real .env.

# Signs/verifies the JWTs issued at login and checked on every outreach route.
JWT_SECRET=change_me_to_something_long_and_random

# AES-256-GCM key SMTP passwords are encrypted with at rest. 32 chars min.
OUTREACH_SECRET=change_me_to_32_characters_min!!

# Shared secret the Outreach tab's one-time sign-in exchanges for a JWT.
# There are no user accounts on this dashboard — this key is the only thing
# gating access to the outreach backend. Keep it private.
OUTREACH_ACCESS_KEY=change_me_to_a_long_random_string

# Port for the server.
PORT=3021

# API prefix. Routes are served at <OUTREACH_API_BASE>/*
# Must match API_BASE in outreach.html.
OUTREACH_API_BASE=/rawleads/api

# Comma-separated list of origins allowed to call this API (CORS). Include
# the dashboard's real GitHub Pages origin in production, e.g.
# https://ddeonmadeit.github.io
OUTREACH_ALLOWED_ORIGIN=http://localhost:8000

# SQLite file.
DB_PATH=./outreach.db
